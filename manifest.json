{
  "manifest_version": 3,
  "name": "BYN prices in USD/EUR/RUB",
  "version": "1.4.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.frankfurter.dev/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.onliner.by/*", "https://*.kufar.by/*", "https://*.realt.by/*", "https://*.flatby.by/*", "https://*.av.by/*", "https://*.abw.by/*", "https://*.21vek.by/*", "https://*.wildberries.by/*", "https://*.ozon.by/*", "https://*.olx.pl/*", "https://*.otodom.pl/*", "https://*.otomoto.pl/*", "https://*.gratka.pl/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "src/sites/*.js"],
      "matches": ["https://*.onliner.by/*", "https://*.kufar.by/*", "https://*.realt.by/*", "https://*.flatby.by/*", "https://*.av.by/*", "https://*.abw.by/*", "https://*.21vek.by/*", "https://*.wildberries.by/*", "https://*.ozon.by/*", "https://*.olx.pl/*", "https://*.otodom.pl/*", "https://*.otomoto.pl/*", "https://*.gratka.pl/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
