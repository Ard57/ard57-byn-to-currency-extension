{
  "manifest_version": 3,
  "name": "BYN to Currency",
  "version": "0.1.0",
  "description": "Display BYN prices in USD, EUR and RUB",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.frankfurter.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
