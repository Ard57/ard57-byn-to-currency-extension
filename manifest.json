{
  "manifest_version": 3,
  "name": "BYN to Currency",
  "version": "0.1.0",
  "description": "Display BYN prices in USD, EUR and RUB",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.frankfurter.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.onliner.by/*", "https://*.kufar.by/*", "https://*.realt.by/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js"],
      "matches": ["https://*.onliner.by/*", "https://*.kufar.by/*", "https://*.realt.by/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
